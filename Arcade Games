        function checkLines() {
            for (var r = 17; r >= 0; r--) {
                var full = true;
                for (var c = 0; c < 10; c++) if (!stackGrid[r][c]) { full = false; break; }
                if (full) {
                    for (var c = 0; c < 10; c++) stackGrid[r][c] = 0;
                    for (var rr = r; rr > 0; rr--) {
                        for (var c = 0; c < 10; c++) stackGrid[rr][c] = stackGrid[rr - 1][c];
                    }
                    for (var c = 0; c < 10; c++) stackGrid[0][c] = 0;
                    r++;
