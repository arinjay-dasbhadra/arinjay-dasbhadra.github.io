        function spawnCoin() {
            coins.push({
                x: 30 + Math.random() * (bounceCanvas.width - 60),
                y: 30 + Math.random() * (bounceCanvas.height * 0.5),
                radius: 12
            });
        }

        function gameLoopBounce() {
            if (!bounceRunning) return;
            
            bounceCtx.clearRect(0, 0, bounceCanvas.width, bounceCanvas.height);
            
            if (paddleLeft) {
                paddleX -= paddleSpeed;
                if (paddleX < 0) paddleX = 0;
            }
            if (paddleRight) {
                paddleX += paddleSpeed;
                if (paddleX + paddleWidth > bounceCanvas.width) paddleX = bounceCanvas.width - paddleWidth;
            }
            
            ballX += ballSpeedX;
            ballY += ballSpeedY;
            
            if (ballX - ballRadius <= 0 || ballX + ballRadius >= bounceCanvas.width) ballSpeedX = -ballSpeedX;
            if (ballY - ballRadius <= 0) ballSpeedY = -ballSpeedY;
            
            if (ballY + ballRadius >= bounceCanvas.height) {
                endBounce();
                return;
            }
            
            if (ballY + ballRadius >= paddleY && ballX >= paddleX && ballX <= paddleX + paddleWidth) {
                ballSpeedY = -Math.abs(ballSpeedY);
                var hitPos = (ballX - paddleX) / paddleWidth;
                ballSpeedX = 8 * (hitPos - 0.5);
            }
            
            for (var i = coins.length - 1; i >= 0; i--) {
                var coin = coins[i];
                var dx = ballX - coin.x;
                var dy = ballY - coin.y;
                var dist = Math.sqrt(dx * dx + dy * dy);
                if (dist < ballRadius + coin.radius) {
                    bounceScore += 10;
                    document.getElementById('bounceScore').innerHTML = bounceScore;
