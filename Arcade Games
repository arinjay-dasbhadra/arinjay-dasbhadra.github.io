        function checkCollision(shape, x, y) {
            for (var r = 0; r < shape.length; r++) {
                for (var c = 0; c < shape[r].length; c++) {
                    if (shape[r][c]) {
                        var newX = x + c;
                        var newY = y + r;
                        if (newX < 0 || newX >= 10 || newY >= 18) return true;
                        if (newY >= 0 && stackGrid[newY] && stackGrid[newY][newX]) return true;
                    }
                }
            }
            return false;
