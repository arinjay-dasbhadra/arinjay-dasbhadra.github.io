        function lockBlock() {
            var shape = stackShapes[stackCurrentShape];
            var color = stackColors[stackCurrentShape];
            for (var r = 0; r < shape.length; r++) {
                for (var c = 0; c < shape[r].length; c++) {
                    if (shape[r][c]) {
                        var gy = stackBlockY + r;
                        var gx = stackBlockX + c;
                        if (gy >= 0 && gy < 18 && gx >= 0 && gx < 10) {
                            stackGrid[gy][gx] = color;
