                    bounceCtx.beginPath();
                    bounceCtx.arc(coin.x, coin.y, coin.radius, 0, Math.PI * 2);
                    bounceCtx.fillStyle = '#f1c40f';
                    bounceCtx.fill();
                    bounceCtx.strokeStyle = '#d4ac0d';
                    bounceCtx.lineWidth = 2;
                    bounceCtx.stroke();
                    bounceCtx.fillStyle = '#fff';
                    bounceCtx.font = '14px Arial';
                    bounceCtx.textAlign = 'center';
                    bounceCtx.fillText('$', coin.x, coin.y + 5);
                    bounceCtx.closePath();
                }
            }
            
            bounceCtx.beginPath();
            bounceCtx.arc(ballX, ballY, ballRadius, 0, Math.PI * 2);
            bounceCtx.fillStyle = '#e74c3c';
            bounceCtx.fill();
            bounceCtx.closePath();
            
            bounceCtx.fillStyle = '#3498db';
            bounceCtx.fillRect(paddleX, paddleY, paddleWidth, paddleHeight);
            
            bounceAnimFrame = requestAnimationFrame(gameLoopBounce);
        }

        function endBounce() {
            bounceRunning = false;
            paddleLeft = false;
            paddleRight = false;
            if (bounceAnimFrame) cancelAnimationFrame(bounceAnimFrame);
            document.getElementById('bounceFinalScore').innerHTML = bounceScore;
            document.getElementById('bounceGameOver').style.display = 'flex';
        }

        function restartBounce() {
            initBounce();
        }

        bounceCanvas = document.getElementById('bounceCanvas');
        if (bounceCanvas) {
            bounceCanvas.addEventListener('mousemove', function(e) {
                var rect = bounceCanvas.getBoundingClientRect();
                paddleX = e.clientX - rect.left - paddleWidth / 2;
                if (paddleX < 0) paddleX = 0;
                if (paddleX + paddleWidth > bounceCanvas.width) paddleX = bounceCanvas.width - paddleWidth;
            });
            
            bounceCanvas.addEventListener('touchmove', function(e) {
                e.preventDefault();
                var rect = bounceCanvas.getBoundingClientRect();
                paddleX = e.touches[0].clientX - rect.left - paddleWidth / 2;
                if (paddleX < 0) paddleX = 0;
                if (paddleX + paddleWidth > bounceCanvas.width) paddleX = bounceCanvas.width - paddleWidth;
            }, { passive: false });
        }

        document.addEventListener('keydown', function(e) {
            if (!bounceRunning) return;
            if (e.key === 'ArrowLeft') paddleLeft = true;
            if (e.key === 'ArrowRight') paddleRight = true;
        });

        document.addEventListener('keyup', function(e) {
            if (e.key === 'ArrowLeft') paddleLeft = false;
            if (e.key === 'ArrowRight') paddleRight = false;
        });
    </script>
</body>
</html>
